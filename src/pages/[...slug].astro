---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = [...(await getCollection('pages')), ...(await getCollection('blog'))];
  return entries.map((entry) => ({
    params: { slug: entry.data.path === '/' ? undefined : entry.data.path.replace(/^\/|\/$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, robots, social, schema, h1, lang } = entry.data;
---
<Base title={title} description={description} robots={robots} social={social} schema={schema} lang={lang}>
  <h1>{h1}</h1>
  <Content />
</Base>
