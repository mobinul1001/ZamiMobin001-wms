---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { wireForms } from '../lib/html-sections';
import { extractCta } from '../lib/polish';
import Home from '../components/templates/Home.astro';
import Pricing from '../components/templates/Pricing.astro';
import Generic from '../components/templates/Generic.astro';
import Article from '../components/templates/Article.astro';
import BlogIndex from '../components/templates/BlogIndex.astro';
import Service from '../components/templates/Service.astro';
import Form from '../components/templates/Form.astro';
import WpPlans from '../components/templates/WpPlans.astro';
import RepairPage from '../components/templates/RepairPage.astro';
import HackedPage from '../components/templates/HackedPage.astro';
import MalwarePage from '../components/templates/MalwarePage.astro';
import MigrationPage from '../components/templates/MigrationPage.astro';
import { HELD_LINES as HACKED_HELD } from '../lib/hacked';

export async function getStaticPaths() {
  const entries = [...(await getCollection('pages')), ...(await getCollection('blog'))];
  return entries.map((entry) => ({
    params: { slug: entry.data.path === '/' ? undefined : entry.data.path.replace(/^\/|\/$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, robots, social, schema, lang, path } = entry.data;
const ARTICLE_PAGES = ['/agreement/', '/website-maintenance-checklist/', '/website-maintenance-process/', '/website-maintenance-case-study/'];
const SERVICE_PAGES = ['/wordpress-website-maintenance-packages/', '/ecommerce-website-maintenance-packages/', '/shopify-website-maintenance-packages/', '/website-repair-services/', '/website-hacked-recovery-services/', '/wordpress-malware-removal-service/', '/website-migration-services/', '/website-redesign-services/', '/website-design-services/', '/website-seo-services/', '/website-speed-optimization-services/', '/website-support-services/', '/website-update-services/', '/wordpress-backup-services/', '/white-label-website-maintenance-services-for-agencies/', '/wms-partner-program/'];
const FORM_PAGES = ['/contact/', '/get-a-free-quote/', '/free-website-maintenance-audit/', '/website-malware-scanner/'];
const pick = () => {
  if (path === '/') return Home;
  if (path === '/wordpress-website-maintenance-packages/') return WpPlans;
  if (path === '/website-repair-services/') return RepairPage;
  if (path === '/website-hacked-recovery-services/') return HackedPage;
  if (path === '/wordpress-malware-removal-service/') return MalwarePage;
  if (path === '/website-migration-services/') return MigrationPage;
  if (path === '/monthly-website-maintenance-packages/') return Pricing;
  if (path === '/blogs/') return BlogIndex;
  if (FORM_PAGES.includes(path)) return Form;
  if (entry.collection === 'blog' || ARTICLE_PAGES.includes(path)) return Article;
  if (SERVICE_PAGES.includes(path) || path.startsWith('/website-maintenance-services-for-')) return Service;
  return Generic;
};
const Template = pick();
if (entry.rendered?.html) entry.rendered.html = wireForms(entry.rendered.html, path);
// Hacked page: the closing section's response-time line is held (owner's brief, rule 6). It moves out of the final
// CTA into the page body, where the page shows it collapsed for the owner to check.
if (Template === HackedPage && entry.rendered?.html) {
  const line = `<p>${HACKED_HELD[1]}</p>`;
  const html = entry.rendered.html;
  const at = html.lastIndexOf('<h2');
  if (!html.includes(line) || at < 0) throw new Error('hacked page: held closing line not found');
  entry.rendered.html = `${html.slice(0, at).trimEnd()}\n${line}\n${html.slice(at).replace(line, '')}`;
}
// A short call to action at the end of a page becomes its final CTA box.
const ctaParts = path === '/blogs/' ? { body: entry.rendered?.html ?? '' } : extractCta(entry.rendered?.html ?? '');
if (entry.rendered?.html) entry.rendered.html = ctaParts.body;
const hasForm = path === '/' || Template === RepairPage || Template === HackedPage || Template === MalwarePage || Template === MigrationPage || Boolean(entry.rendered?.html?.includes('https://formspree.io/f/'));
---
<Base title={title} description={description} robots={robots} social={social} schema={schema} lang={lang} cta={ctaParts.cta}>
  {hasForm && <script is:inline defer src="/forms.js" slot="head"></script>}
  <Template entry={entry} />
</Base>
