---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Home from '../components/templates/Home.astro';
import Pricing from '../components/templates/Pricing.astro';
import Generic from '../components/templates/Generic.astro';

export async function getStaticPaths() {
  const entries = [...(await getCollection('pages')), ...(await getCollection('blog'))];
  return entries.map((entry) => ({
    params: { slug: entry.data.path === '/' ? undefined : entry.data.path.replace(/^\/|\/$/g, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, robots, social, schema, lang, path } = entry.data;
const Template = path === '/' ? Home : path === '/monthly-website-maintenance-packages/' ? Pricing : Generic;
---
<Base title={title} description={description} robots={robots} social={social} schema={schema} lang={lang}>
  <Template entry={entry} />
</Base>
