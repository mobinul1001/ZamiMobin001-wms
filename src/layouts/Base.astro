---
import '../styles/site.css';
import '../styles/footer.css';
import foot from '../data/footer.json';
import site from '../data/site.json';
import { icon } from '../lib/icons';
import { homeFinalHtml } from '../lib/home';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  social?: Record<string, unknown>;
  schema?: unknown[];
  lang?: string;
  cta?: { id?: string; title: string; text: string; links: { href: string; label: string }[] };
}
const { title, description, robots, schema = [], lang = 'en-US', cta } = Astro.props;
let { social = {} } = Astro.props as { social?: Record<string, unknown> };

// Netlify sets CONTEXT and URL during builds. Only a production build on the real domain
// may be indexed, so the netlify.app address and any misconfigured build stay noindex.
const isProduction = process.env.CONTEXT === 'production' && process.env.URL === Astro.site?.origin;
const robotsContent = isProduction ? robots || 'index, follow' : 'noindex, nofollow';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Batch 3 (gap audit): every page has og:title (falls back to the page title) and twitter:image (= og:image).
social = { ...social };
if (!social['og:title']) social['og:title'] = title;
if (!social['twitter:image'] && social['og:image']) social['twitter:image'] = [].concat(social['og:image'])[0];
const socialTags = Object.entries(social).flatMap(([key, value]) => (Array.isArray(value) ? value : [value]).map((content) => ({ key, content: String(content) })));
const logo = '/wp-content/uploads/2025/11/Colorful-Website-Maintenance-services-Logo.png';
// Every service page, in the owner's 4 groups (2026-11-05). The build fails if a menu link has no page.
// Desktop shows 3 columns: Maintenance | Fix and security + Partners | Build and grow.
const serviceGroups: [string, [string, string][]][] = [
  ['Maintenance', [
    ['WordPress maintenance', '/wordpress-website-maintenance-packages/'],
    ['Ecommerce maintenance', '/ecommerce-website-maintenance-packages/'],
    ['Shopify maintenance', '/shopify-website-maintenance-packages/'],
    ['Website support', '/website-support-services/'],
    ['Website updates', '/website-update-services/'],
    ['Website backup', '/wordpress-backup-services/'],
  ]],
  ['Fix and security', [
    ['Website repair', '/website-repair-services/'],
    ['Hacked site recovery', '/website-hacked-recovery-services/'],
    ['Malware removal', '/wordpress-malware-removal-service/'],
    ['Website speed optimization', '/website-speed-optimization-services/'],
  ]],
  ['Build and grow', [
    ['Website migration', '/website-migration-services/'],
    ['Website SEO', '/website-seo-services/'],
    ['Website design', '/website-design-services/'],
    ['Website redesign', '/website-redesign-services/'],
  ]],
  ['Partners', [
    ['White-label services', '/white-label-website-maintenance-services-for-agencies/'],
    ['Partner program', '/wms-partner-program/'],
  ]],
];
const [gMaint, gFix, gBuild, gPartners] = serviceGroups;
const menuCols = [[gMaint], [gFix, gPartners], [gBuild]];
const main = [
  ['Pricing', '/monthly-website-maintenance-packages/'],
  ['Blog', '/blogs/'],
  ['About', '/about-us/'],
  ['Contact', '/contact/'],
];
const quote = '/get-a-free-quote/';
const code = lang.slice(0, 2);
const isPt = code === 'pt';
// Footer link to the cookie policy (2026-11-06: replaces the "Cookie settings" button, whose cookie bar was removed).
const cookieText = isPt ? { policy: 'Política de cookies' } : { policy: 'Cookie policy' };
const CTA_DEFAULT: Record<string, { title: string; text: string; links: { href: string; label: string }[] }> = {
  en: { title: 'Keep your website fast, secure and up to date.', text: 'Tell us what your site needs. We reply with a clear plan and price.', links: [{ href: quote, label: 'Get a free quote' }, { href: '/monthly-website-maintenance-packages/', label: 'See plans & pricing' }] },
  es: { title: 'Mantén tu sitio web rápido, seguro y actualizado.', text: 'Cuéntanos qué necesita tu sitio. Te respondemos con un plan y un precio claros.', links: [{ href: quote, label: 'Pedir un presupuesto gratis' }, { href: '/monthly-website-maintenance-packages/', label: 'Ver planes y precios' }] },
  pt: { title: 'Mantenha seu site rápido, seguro e atualizado.', text: 'Conte o que seu site precisa. Respondemos com um plano e um preço claros.', links: [{ href: quote, label: 'Pedir um orçamento grátis' }, { href: '/monthly-website-maintenance-packages/', label: 'Ver planos e preços' }] },
};
const finalCta = cta ?? CTA_DEFAULT[code] ?? CTA_DEFAULT.en;
// Footer (owner's final design, 2026-11-04): copy and links in src/data/footer.json, company facts in site.json.
const footStats = site.stats.map(([v, l]) => [v, (foot.statLabels as Record<string, string>)[l] ?? l]);
const svg = (inner: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
const brandSvg = (name: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${(foot.socialIcons as Record<string, string>)[name]}"/></svg>`;
const [icCompany, icPin, icPhone, icMail] = foot.contactIcons;
const [mailUser, mailDomain] = site.email.split('@');
const isHome = Astro.url.pathname === '/';
const themeBtn = (id: string) => `<button class="theme" id="${id}" type="button" aria-label="Switch between light and dark theme">${icon('sun', 'sun')}${icon('moon', 'moon')}</button>`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>(function(){var t;try{t=localStorage.getItem('wms-theme')}catch(e){}if(t!=='dark'&&t!=='light')t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';var r=document.documentElement;r.setAttribute('data-theme',t);r.classList.add('js')})()</script>
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {socialTags.map(({ key, content }) => (key.startsWith('twitter:') ? <meta name={key} content={content} /> : <meta property={key} content={content} />))}
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
    {isProduction && (
      <script is:inline>
        // Consent Mode v2 default: everything stays denied. The cookie bar and its tag loader were removed on 2026-11-05
        // (owner); GA4 and Clarity do not load; the owner sets them up later (reports/TODO.md).
        window.wmsAnalytics = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      </script>
    )}
  </head>
  <body>
    <header class="top site-head"><div class="wrap">
      <a class="logo" href="/" aria-label="Home"><img src={logo} alt="WMS logo" width="325" height="108" /></a>
      <nav class="nav" aria-label="Main">
        <details class="drop"><summary aria-expanded="false" aria-controls="svc-menu">Services<Fragment set:html={icon('down')} /></summary><div class="drop-menu" id="svc-menu">{menuCols.map((col) => (
          <div class="drop-col">{col.map(([title, links]) => <div class="drop-group"><p class="drop-h">{title}</p><ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></div>)}</div>
        ))}</div></details>
        {main.map(([label, href]) => <a href={href}>{label}</a>)}
        <Fragment set:html={themeBtn('theme')} />
        <a class="btn primary" href={quote}>Get a free quote</a>
      </nav>
      <a class="btn primary cta-m" href={quote}>Get a free quote</a>
      <button class="burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mnav"><Fragment set:html={icon('menu', 'open') + icon('x', 'close')} /></button>
    </div></header>
    <nav class="mnav" id="mnav" aria-label="Mobile">
      <details class="m-svc"><summary aria-expanded="false" aria-controls="m-svc">Services<Fragment set:html={icon('down')} /></summary><div class="m-svc-list" id="m-svc">{serviceGroups.map(([title, links]) => <><p class="mnav-h">{title}</p>{links.map(([label, href]) => <a href={href}>{label}</a>)}</>)}</div></details>
      {main.map(([label, href]) => <a href={href}>{label}</a>)}
      <div class="theme-row"><span>Theme</span><Fragment set:html={themeBtn('theme-m')} /></div>
      <a class="btn primary" href={quote}>Get a free quote</a>
    </nav>
    <main>
      <slot />
    </main>
    {isHome ? <Fragment set:html={homeFinalHtml(cta)} /> : <section class="cta-sec" data-sec="final"><div class="wrap"><div class="final">
      <div>
        {cta ? <h2 id={cta.id} set:html={finalCta.title} /> : <p class="final-title">{finalCta.title}</p>}
        <p set:html={finalCta.text} />
      </div>
      <div class="act">{finalCta.links.map((l, i) => <a class:list={['btn', i === 0 ? 'white' : 'ghost']} href={l.href}>{l.label}</a>)}</div>
    </div></div></section>}
    <footer class="wmsf" data-sec="footer" aria-label="Site footer"><div class="wf-glow"></div><div class="wf-mark" aria-hidden="true">WMS</div><div class="wf-w">
      <div class="wf-panel">
        <div class="wf-head"><span class="wf-eb">{foot.eyebrow}</span><p class="wf-title" set:html={foot.headline} /></div>
        <ul class="wf-stats">{footStats.map(([v, l]) => <li><b>{v}</b><span>{l}</span></li>)}</ul>
        <ul class="wf-contact">
          <li class="wf-ci"><span class="wf-ic wf-c1" set:html={svg(icCompany)} /><span>{site.gbp.name}</span></li>
          {/* Batch 4 (owner): phone and address are in the footer HTML on the homepage only. */}
          {isHome && <li class="wf-ci"><span class="wf-ic wf-c2" set:html={svg(icPin)} /><span>{site.address}</span></li>}
          {isHome && <li class="wf-ci"><span class="wf-ic wf-c3" set:html={svg(icPhone)} /><a href={site.phoneHref}>{site.phone}</a></li>}
          <li class="wf-ci"><span class="wf-ic wf-c4" set:html={svg(icMail)} /><a href={`mailto:${site.email}`}>{mailUser}<wbr />@{mailDomain}</a></li>
        </ul>
      </div>
      <div class="wf-grid">
        <div class="wf-brand">
          <a href="/" aria-label={`${site.brand} home`}><img class="wf-logo" src={logo} alt={site.brand} width="325" height="108" loading="lazy" /></a>
          <p>{foot.brand}</p>
          <div class="wf-soc">{site.social.map(([name, href]) => <a class={`wf-sb wf-sb-${name.toLowerCase()}`} href={href} aria-label={name} rel="noopener" target="_blank" set:html={brandSvg(name)} />)}</div>
        </div>
        {(foot.cols as [string, string[][]][]).map(([heading, links]) => (
          <details class="wf-col" open><summary>{heading}</summary><ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></details>
        ))}
      </div>
      <div class="wf-legal"><span>{foot.copyright}</span><span class="wf-ll">{(foot.legal as string[][]).map(([label, href]) => <a href={href}>{label}</a>)}<a href="/cookie-policy/">{cookieText.policy}</a></span></div>
    </div></footer>
    {isHome && <div class="mbar"><a class="btn primary" href="#quote">Get a free quote<Fragment set:html={icon('arrow')} /></a></div>}
    <script is:inline>
      (function () {
        var d = document, r = d.documentElement;
        function flip() { var t = r.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'; r.setAttribute('data-theme', t); try { localStorage.setItem('wms-theme', t); } catch (e) {} }
        d.getElementById('theme').addEventListener('click', flip);
        d.getElementById('theme-m').addEventListener('click', flip);
        var b = d.getElementById('burger'), m = d.getElementById('mnav');
        function menu(on) { if (on) m.style.top = Math.max(0, b.closest('header').getBoundingClientRect().bottom) + 'px'; m.classList.toggle('on', on); b.setAttribute('aria-expanded', on); d.body.classList.toggle('menu-open', on); if (on) { var f = m.querySelector('summary'); if (f) f.focus(); } }
        b.addEventListener('click', function () { menu(b.getAttribute('aria-expanded') !== 'true'); });
        d.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { if (m.classList.contains('on')) { menu(false); b.focus(); } d.querySelectorAll('.drop[open]').forEach(function (x) { x.open = false; x.querySelector('summary').focus(); }); }
          if (e.key === 'Tab' && m.classList.contains('on')) { var a = [b].concat([].slice.call(m.querySelectorAll('a,summary,button'))).filter(function (x) { return x.offsetParent !== null; }), l = a[a.length - 1]; if (e.shiftKey && d.activeElement === b) { e.preventDefault(); l.focus(); } else if (!e.shiftKey && d.activeElement === l) { e.preventDefault(); b.focus(); } }
        });
        d.querySelectorAll('.drop, .m-svc').forEach(function (x) { var s = x.querySelector('summary'); x.addEventListener('toggle', function () { s.setAttribute('aria-expanded', x.open); }); });
        d.addEventListener('click', function (e) { d.querySelectorAll('.drop[open]').forEach(function (x) { if (!x.contains(e.target)) x.open = false; }); });
        matchMedia('(min-width: 1081px)').addEventListener('change', function (e) { if (e.matches) menu(false); });
        var fm = matchMedia('(max-width: 640px)'), cols = d.querySelectorAll('.wf-col');
        // Re-checked on load and resize too: the first check can run before the final width is known.
        var lastMob = null;
        function footCols() { var mob = fm.matches; if (mob === lastMob) return; lastMob = mob; cols.forEach(function (c) { c.open = !mob; }); }
        footCols(); fm.addEventListener('change', footCols); addEventListener('load', footCols); addEventListener('resize', footCols);
        cols.forEach(function (c) { c.querySelector('summary').addEventListener('click', function (e) { if (!fm.matches) e.preventDefault(); }); });
        var all = d.querySelectorAll('.fade');
        if ('IntersectionObserver' in window) { var o = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); o.unobserve(e.target); } }); }, { rootMargin: '0px 0px -6% 0px' }); all.forEach(function (e) { o.observe(e); }); } else all.forEach(function (e) { e.classList.add('in'); });
      })();
    </script>
  </body>
</html>
