---
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  social?: Record<string, unknown>;
  schema?: unknown[];
  lang?: string;
  plansHref?: string;
}
const { title, description, robots, social = {}, schema = [], lang = 'en-US', plansHref = '/monthly-website-maintenance-packages/' } = Astro.props;

// Netlify sets CONTEXT and URL during builds. Only a production build on the real domain
// may be indexed, so the netlify.app address and any misconfigured build stay noindex.
const isProduction = process.env.CONTEXT === 'production' && process.env.URL === Astro.site?.origin;
const robotsContent = isProduction ? robots || 'index, follow' : 'noindex, nofollow';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialTags = Object.entries(social).flatMap(([key, value]) => (Array.isArray(value) ? value : [value]).map((content) => ({ key, content: String(content) })));
const logo = '/wp-content/uploads/2025/11/Colorful-Website-Maintenance-services-Logo.png';
const services = [
  ['WordPress maintenance', '/wordpress-website-maintenance-packages/'],
  ['Ecommerce maintenance', '/ecommerce-website-maintenance-packages/'],
  ['Shopify maintenance', '/shopify-website-maintenance-packages/'],
  ['Website support', '/website-support-services/'],
  ['Website repair', '/website-repair-services/'],
  ['Malware removal', '/wordpress-malware-removal-service/'],
];
const main = [
  ['Pricing', '/monthly-website-maintenance-packages/'],
  ['Blog', '/blogs/'],
  ['About', '/about-us/'],
  ['Contact', '/contact/'],
];
const current = Astro.url.pathname;
const isPt = lang.startsWith('pt');
const cookieText = isPt
  ? { message: 'Usamos cookies de análise para melhorar este site.', accept: 'Aceitar', reject: 'Recusar', policy: 'Política de privacidade', settings: 'Configurações de cookies' }
  : { message: 'We use analytics cookies to improve this site.', accept: 'Accept', reject: 'Reject', policy: 'Privacy policy', settings: 'Cookie settings' };
const footerCols = [
  ['Services', [...services, ['White label for agencies', '/white-label-website-maintenance-services-for-agencies/'], ['Website migration', '/website-migration-services/'], ['Speed optimization', '/website-speed-optimization-services/']]],
  ['Company', [['About us', '/about-us/'], ['Our work', '/works/'], ['Pricing', '/monthly-website-maintenance-packages/'], ['Process', '/website-maintenance-process/'], ['Checklist', '/website-maintenance-checklist/'], ['Case study', '/website-maintenance-case-study/'], ['Blog', '/blogs/'], ['Partner program', '/wms-partner-program/'], ['Write for us', '/write-for-us/']]],
  ['Help and trust', [['Contact', '/contact/'], ['Free website check', '/free-website-maintenance-audit/'], ['Malware scanner', '/website-malware-scanner/'], ['Get a quote', '/get-a-free-quote/'], ['Agreement', '/agreement/'], ['Privacy policy', '/privacy-policy/'], ['Terms', '/terms-conditions/'], ['Refund policy', '/refund-cancellation-policy/'], ['Cookie policy', '/cookie-policy/']]],
] as [string, string[][]][];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {socialTags.map(({ key, content }) => (key.startsWith('twitter:') ? <meta name={key} content={content} /> : <meta property={key} content={content} />))}
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
    {isProduction && (
      <script is:inline>
        // Consent Mode v2: everything stays denied, and no tag loads until the visitor accepts (public/consent.js).
        window.wmsAnalytics = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      </script>
    )}
    <script is:inline defer src="/consent.js"></script>
  </head>
  <body>
    <header class="site-head"><div class="wrap">
      <a class="logo" href="/"><img src={logo} alt="WMS logo" width="325" height="108" /></a>
      <nav class="nav" aria-label="Main">
        <details class="nav-drop"><summary>Services</summary><ul>{services.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></details>
        {main.map(([label, href]) => <a href={href} class:list={{ on: current === href }}>{label}</a>)}
        <a class="btn" href={plansHref}>See plans</a>
      </nav>
      <details class="menu"><summary>Menu</summary><div>
        {services.map(([label, href]) => <a class="sub-link" href={href}>{label}</a>)}
        {main.map(([label, href]) => <a href={href}>{label}</a>)}
        <a class="btn" href={plansHref}>See plans</a>
      </div></details>
    </div></header>
    <main>
      <slot />
    </main>
    <footer class="foot"><div class="wrap">
      <div class="foot-grid">
        <div>
          <img src={logo} alt="WMS logo" width="325" height="108" style="height:38px;width:auto" loading="lazy" />
          <p class="muted small" style="margin-top:10px">Dhaka-based team, working US &amp; UK business hours.<br />No contract. Cancel anytime.</p>
          <p class="small" style="margin-top:10px"><a href="mailto:contact@websitemaintenanceservices.org">contact@websitemaintenanceservices.org</a><br /><a href="https://wa.me/8801815840813">+8801815840813</a></p>
        </div>
        {footerCols.map(([heading, links]) => (
          <div><h3>{heading}</h3><ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></div>
        ))}
      </div>
      <p class="legal">© 2026 WMS. websitemaintenanceservices.org · <button type="button" id="cookie-settings" class="link-button">{cookieText.settings}</button></p>
    </div></footer>
    <div id="cookie-bar" class="cookie-bar" role="region" aria-label={cookieText.settings} hidden>
      <p>{cookieText.message} <a href="/privacy-policy/">{cookieText.policy}</a></p>
      <div class="cookie-actions"><button type="button" id="cookie-accept" class="btn ghost">{cookieText.accept}</button><button type="button" id="cookie-reject" class="btn ghost">{cookieText.reject}</button></div>
    </div>
  </body>
</html>
