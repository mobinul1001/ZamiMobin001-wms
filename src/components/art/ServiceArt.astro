---
// Original decorative hero art for the batch-2 service pages (inline SVG, brand gradient, light and dark through CSS
// variables, fixed 4:3 ratio, aria-hidden). No numbers, no client names, nothing that reads as real data.
interface Props { kind: 'redesign' | 'design' | 'seo' | 'speed' | 'support' | 'update' | 'backup' | 'hosting' | 'scanner' | 'whitelabel' | 'partner' | 'store' | 'country'; label?: string; flag?: string }
const { kind, label = '', flag = '' } = Astro.props;
const id = `sa-${kind}`;
---
<svg class="sv-art" viewBox="0 0 240 180" width="240" height="180" aria-hidden="true" focusable="false">
  <defs><linearGradient id={id} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6d34e0" /><stop offset=".55" stop-color="#c026d3" /><stop offset="1" stop-color="#f43f5e" /></linearGradient></defs>
  <rect x="4" y="4" width="232" height="172" rx="22" class="sa-bg" />
  {kind === 'redesign' && (<g>
    <rect x="22" y="40" width="80" height="100" rx="10" class="sa-card" /><rect x="138" y="40" width="80" height="100" rx="10" class="sa-card" />
    <rect x="32" y="52" width="60" height="10" rx="4" class="sa-line" /><rect x="32" y="70" width="40" height="8" rx="4" class="sa-line" /><rect x="32" y="86" width="60" height="40" rx="6" class="sa-line" />
    <rect x="148" y="52" width="60" height="14" rx="5" fill={`url(#${id})`} /><rect x="148" y="74" width="28" height="52" rx="6" class="sa-line" /><rect x="180" y="74" width="28" height="24" rx="6" class="sa-line" /><rect x="180" y="102" width="28" height="24" rx="6" class="sa-line" />
    <path d="M106 70h26m-8-7 8 7-8 7M106 110h26m-8-7 8 7-8 7" fill="none" stroke={`url(#${id})`} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  </g>)}
  {kind === 'design' && (<g>
    <rect x="26" y="30" width="188" height="122" rx="12" class="sa-card" /><circle cx="42" cy="44" r="4" class="sa-dot" /><circle cx="54" cy="44" r="4" class="sa-dot" /><circle cx="66" cy="44" r="4" class="sa-dot" />
    <rect x="40" y="60" width="160" height="30" rx="8" fill={`url(#${id})`} /><rect x="40" y="98" width="48" height="40" rx="7" class="sa-line" /><rect x="96" y="98" width="48" height="40" rx="7" class="sa-line" /><rect x="152" y="98" width="48" height="40" rx="7" class="sa-line" />
  </g>)}
  {kind === 'seo' && (<g>
    <rect x="24" y="30" width="150" height="70" rx="10" class="sa-card" /><rect x="36" y="44" width="70" height="8" rx="4" fill={`url(#${id})`} /><rect x="36" y="60" width="120" height="7" rx="3.5" class="sa-line" /><rect x="36" y="74" width="100" height="7" rx="3.5" class="sa-line" />
    <circle cx="182" cy="62" r="20" fill="none" stroke={`url(#${id})`} stroke-width="6" /><path d="m196 76 16 16" stroke={`url(#${id})`} stroke-width="7" stroke-linecap="round" />
    <path d="M30 150c30-6 44-22 66-24s38 8 62-6 40-28 54-40" fill="none" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" />
  </g>)}
  {kind === 'speed' && (<g>
    <path d="M40 120a60 60 0 0 1 120 0" fill="none" class="sa-track" stroke-width="14" stroke-linecap="round" /><path d="M40 120a60 60 0 0 1 104-41" fill="none" stroke={`url(#${id})`} stroke-width="14" stroke-linecap="round" />
    <path d="m100 120 32-34" stroke-width="6" stroke-linecap="round" class="sa-needle" /><circle cx="100" cy="120" r="8" fill={`url(#${id})`} />
    <rect x="172" y="50" width="48" height="10" rx="5" fill={`url(#${id})`} /><rect x="172" y="68" width="36" height="10" rx="5" class="sa-line" /><rect x="172" y="86" width="26" height="10" rx="5" class="sa-line" /><rect x="172" y="104" width="16" height="10" rx="5" class="sa-line" />
    <rect x="40" y="142" width="160" height="8" rx="4" class="sa-line" />
  </g>)}
  {kind === 'support' && (<g>
    <rect x="22" y="28" width="140" height="40" rx="12" class="sa-card" /><rect x="34" y="40" width="90" height="7" rx="3.5" class="sa-line" /><rect x="34" y="52" width="60" height="7" rx="3.5" class="sa-line" />
    <rect x="78" y="78" width="140" height="40" rx="12" fill={`url(#${id})`} /><rect x="90" y="90" width="100" height="7" rx="3.5" fill="#fff" opacity=".85" /><rect x="90" y="102" width="70" height="7" rx="3.5" fill="#fff" opacity=".6" />
    <rect x="22" y="128" width="120" height="34" rx="12" class="sa-card" /><circle cx="44" cy="145" r="7" fill={`url(#${id})`} /><rect x="58" y="141" width="66" height="7" rx="3.5" class="sa-line" />
  </g>)}
  {kind === 'update' && (<g>
    <rect x="30" y="122" width="56" height="30" rx="8" class="sa-card" /><rect x="70" y="88" width="56" height="30" rx="8" class="sa-card" /><rect x="110" y="54" width="56" height="30" rx="8" fill={`url(#${id})`} />
    <path d="M58 118v-12h40M98 84V72h40" fill="none" class="sa-track" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M190 40l26 10v22c0 18-12 30-26 36-14-6-26-18-26-36V50z" fill="none" stroke={`url(#${id})`} stroke-width="6" stroke-linejoin="round" /><path d="m180 72 8 8 14-16" fill="none" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  </g>)}
  {kind === 'whitelabel' && (<g>
    <rect x="22" y="34" width="92" height="112" rx="12" class="sa-card" /><rect x="34" y="48" width="68" height="16" rx="6" fill={`url(#${id})`} /><rect x="34" y="74" width="56" height="7" rx="3.5" class="sa-line" /><rect x="34" y="88" width="68" height="7" rx="3.5" class="sa-line" /><rect x="34" y="102" width="44" height="7" rx="3.5" class="sa-line" />
    <rect x="126" y="34" width="92" height="112" rx="12" class="sa-card" stroke-dasharray="6 5" /><circle cx="152" cy="64" r="10" class="sa-line" /><circle cx="180" cy="64" r="10" class="sa-line" /><rect x="138" y="88" width="68" height="7" rx="3.5" class="sa-line" /><rect x="138" y="102" width="52" height="7" rx="3.5" class="sa-line" />
    <path d="M114 128h12" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" />
  </g>)}
  {kind === 'partner' && (<g>
    <circle cx="52" cy="70" r="22" class="sa-card" /><circle cx="188" cy="70" r="22" class="sa-card" /><circle cx="120" cy="120" r="24" fill={`url(#${id})`} />
    <path d="M70 84l30 22M170 84l-30 22" fill="none" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" />
    <rect x="40" y="62" width="24" height="7" rx="3.5" class="sa-line" /><rect x="176" y="62" width="24" height="7" rx="3.5" class="sa-line" /><path d="m110 120 7 7 13-14" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
  </g>)}
  {kind === 'country' && (<g>
    <rect x="30" y="122" width="180" height="30" rx="15" class="sa-card" /><text x="120" y="142" text-anchor="middle" font-size="15" font-weight="700" class="sa-text">{label}</text>
    <path d="M120 26c-22 0-38 16-38 37 0 27 38 55 38 55s38-28 38-55c0-21-16-37-38-37z" fill={`url(#${id})`} />
    <circle cx="120" cy="62" r="20" fill="#fff" />{flag && <image href={`/flags/${flag}.svg`} x="106" y="52" width="28" height="21" preserveAspectRatio="xMidYMid slice" />}
  </g>)}
  {kind === 'store' && (<g>
    <path d="M40 52h20l16 64h96l14-46H66" fill="none" stroke={`url(#${id})`} stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="88" cy="136" r="10" class="sa-card" /><circle cx="160" cy="136" r="10" class="sa-card" />
    <rect x="86" y="80" width="26" height="22" rx="5" class="sa-line" /><rect x="120" y="80" width="26" height="22" rx="5" class="sa-line" /><rect x="154" y="80" width="18" height="22" rx="5" class="sa-line" />
    <path d="M188 30l22 8v18c0 14-10 24-22 28-12-4-22-14-22-28V38z" class="sa-card" />
  </g>)}
  {kind === 'backup' && (<g>
    <path d="M28 120h184" class="sa-track" stroke-width="6" stroke-linecap="round" />
    <circle cx="48" cy="120" r="12" class="sa-card" /><circle cx="96" cy="120" r="12" class="sa-card" /><circle cx="144" cy="120" r="12" class="sa-card" /><circle cx="192" cy="120" r="14" fill={`url(#${id})`} />
    <rect x="60" y="36" width="120" height="52" rx="12" class="sa-card" /><rect x="74" y="50" width="56" height="8" rx="4" fill={`url(#${id})`} /><rect x="74" y="66" width="86" height="7" rx="3.5" class="sa-line" />
    <path d="M150 96c-10 10-24 12-38 6" fill="none" stroke={`url(#${id})`} stroke-width="4" stroke-linecap="round" /><path d="m112 96 0 8 8 0" fill="none" stroke={`url(#${id})`} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  </g>)}
</svg>
