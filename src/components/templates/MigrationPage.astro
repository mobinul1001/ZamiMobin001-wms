---
// Website migration page, owner's design (batch 1, design-reference/migration/, 2026-11-05). All text is the page's
// own (src/lib/migration.ts); prices from prices.json (pending the owner's confirmation). Header, footer and the
// final CTA band come from Base.astro. Reuses the plans, repair, hacked and malware page styles.
import { getCollection } from 'astro:content';
import hubs from '../../data/blog-hubs.json';
import prices from '../../data/prices.json';
import { icon, tick } from '../../lib/icons';
import { quickForm } from '../../lib/home';
import { parseMigration } from '../../lib/migration';
import plansCss from '../../styles/plans-page.css?url';
import repairCss from '../../styles/repair-page.css?url';
import hackedCss from '../../styles/hacked-page.css?url';
import malwareCss from '../../styles/malware-page.css?url';
import migrationCss from '../../styles/migration-page.css?url';
import SectionAccordion from '../plans/SectionAccordion.astro';
import TrustStrip from '../service/TrustStrip.astro';
import Countries from '../service/Countries.astro';

const { entry } = Astro.props;
const { path, h1 } = entry.data;
const d = parseMigration(entry.rendered?.html ?? '');
const posts = await getCollection('blog');
const guides = hubs.filter((t) => t.hub === path).flatMap((t) => t.posts).slice(0, 6).map((s) => posts.find((p) => p.data.path === `/${s}/`)).filter(Boolean);
const form = quickForm('migration', 'Get a free website check', 'Tell us about your site. We reply within 24 hours with a free check and your exact price.', 'migration-hero', 'Migration or redesign');
const P = prices.migrationPrices;
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
const rm = (label: string, body: string, cls = '') => `<details class="pp-rm ${cls}"><summary>${label}${icon('down')}</summary><div class="pp-prose">${body}</div></details>`;
const OWNER = (what: string) => `<!-- OWNER CHECK: ${what} -->`;
const faqItem = (f: (typeof d.faq.items)[number], note = '') => `<details><summary><h3 id="${f.id}">${f.q}</h3>${icon('down')}</summary><div class="a">${note}<p>${f.a}</p>${f.extra.map((x) => (/within 30 days/.test(x) ? OWNER('"free fix within 30 days" (held by the brief, rule 6, for hero, cards, headings and meta)') : '') + `<p>${x}</p>`).join('')}</div></details>`;
const FAQ_NOTE: Record<number, string> = { 1: OWNER('"No." as a guarantee (held by the brief, rule 6)'), 2: OWNER('"visitors won’t notice any interruption" (held by the brief, rule 6)'), 3: OWNER('platform change "starts at $999": the brief gives $1,199 (pending)') };
const [t0, t1, t2] = d.pricing.tiers;
const COLORS = ['#1d6fd8', '#0a7f54', '#c2410c', '#7e22ce', '#be185d', '#047857', '#4338ca'];
const caseCard = (c: (typeof d.cases.items)[number], dup: boolean) => `<article class="card mg-case"${dup ? ' aria-hidden="true"' : ''}><p class="rp-chips"><span class="rp-chip">${c.tag}</span><span class="rp-chip">${c.n}</span></p>${dup ? `<p class="mg-case-h">${c.h}</p>` : `<h3 id="${c.id}">${c.h}</h3>`}<p class="mg-domain">${c.domain}</p>${c.body.map((b) => `<p>${b}</p>`).join('')}${c.result ? `<p class="rp-chk">${tick}<span>${c.result}</span></p>` : ''}${dup ? '' : OWNER('case study numbers (held by the brief, rule 6)') + rm('Read more', c.numbers.map((n) => `<p>${n}</p>`).join(''))}</article>`;
---
<link rel="stylesheet" href={plansCss} />
<link rel="stylesheet" href={repairCss} />
<link rel="stylesheet" href={hackedCss} />
<link rel="stylesheet" href={malwareCss} />
<link rel="stylesheet" href={migrationCss} />
<div class="plans-pg repair-pg hacked-pg malware-pg migration-pg">
  <section class="rp-hero"><div class="wrap">
    <div class="rp-hero-text">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / {h1}</nav>
      <h1 set:html={h1.replace(/&/g, '&amp;').replace(/(\S+)$/, '<span class="hl">$1</span>')} />
      <p class="rp-sub" set:html={d.hero.lead} />
      <p class="rp-priceline"><a class="mw-priceline-link" href="#pricing"><b>{t0.h} {money(P.hostMove)}</b></a><span>{t1.h} {money(P.full)}</span><span>{t2.h} from {money(P.platformFrom)}</span></p>
      <div class="cta-row">{d.hero.links.map((l, i) => <a class:list={['btn', i === 0 ? 'primary' : 'ghost']} href={l.href}>{l.label}{i === 0 && <Fragment set:html={icon('arrow')} />}</a>)}</div>
      <ul class="rp-ticks"><li><Fragment set:html={tick} /><span set:html={d.hero.trustLine} /></li><li><Fragment set:html={tick} /><span set:html={d.pricing.free} /></li></ul>
      <Fragment set:html={OWNER('the full hero intro ("without losing traffic, data, or SEO rankings") and the 3 stat cards (100% data integrity, zero SEO ranking loss, under 15 minutes downtime), held by the brief, rule 6') + rm('Read more', `<p>${d.hero.introFull}</p>` + d.hero.heldStats.map((s) => `<p>${s.replace(/<\/?p[^>]*>/g, ' ')}</p>`).join(''))} />
      <Fragment set:html={OWNER('the "Live Transfer" Example panel: kept as an example, not live data')} />
      <details class="card mw-panel"><summary set:html={(d.hero.panel.match(/<p class="status-head">[\s\S]*?<\/p>/)?.[0] ?? '') + icon('down')} /><div class="rp-panel" set:html={d.hero.panel.replace(/<p class="status-head">[\s\S]*?<\/p>/, '')} /></details>
    </div>
    <div class="rp-hero-side" id="quote"><Fragment set:html={form} /></div>
  </div></section>
  <TrustStrip />
  <section class="hk-platforms"><div class="wrap">
    <p class="rp-subhd mg-plat-h">{d.hero.platformsTitle}</p>
    <p class="mg-plat-lead">{d.hero.platformsLead}</p>
    <ul class="hk-chips" aria-label={d.hero.platformsTitle}>{d.hero.platforms.map((p) => <li>{p}</li>)}</ul>
  </div></section>

  <SectionAccordion eyebrow={d.overview.sec.eyebrow} h2={d.overview.sec.h2} id={d.overview.sec.id} open>
    <div class="mw-prose mw-intro" set:html={d.overview.rest.split('</p>').slice(0, 2).join('</p>') + '</p>'} />
    <div class="rp-grid3 mw-cards" set:html={d.overview.cards.join('')} />
    <div class="rp-strip mw-prose" set:html={d.overview.rest.split('</p>').slice(2).join('</p>')} />
  </SectionAccordion>

  <SectionAccordion eyebrow={d.process.sec.eyebrow} h2={d.process.sec.h2} id="migration-process">
    <p class="sx-lead" set:html={d.process.lead} />
    <ol class="mg-steps">{d.process.steps.map((s, i) => (
      <li class="card mg-step"><span class="n" style={`--sc:${COLORS[i]}`}>{s.n}</span><h3 id={s.id} set:html={s.h} /><p set:html={s.p} /><p class="rp-chk"><Fragment set:html={tick} /><span>{s.badge}</span></p></li>
    ))}<li class="mg-step-cta" set:html={d.process.cta} /></ol>
  </SectionAccordion>

  <SectionAccordion eyebrow={d.platforms.sec.eyebrow} h2={d.platforms.sec.h2} id={d.platforms.sec.id} alt>
    <div class="mw-prose mw-intro" set:html={d.platforms.rest.split('<h3')[0]} />
    <ul class="hk-chips mw-chips">{d.platforms.names.map((n) => <li>{n}</li>)}</ul>
    <details class="pp-rm"><summary>Read more<Fragment set:html={icon('down')} /></summary><div class="rp-grid4 mw-cards" set:html={d.platforms.cards.join('')} /></details>
    <div class="rp-strip mw-prose" set:html={'<h3' + d.platforms.rest.split('<h3').slice(1).join('<h3')} />
  </SectionAccordion>

  <SectionAccordion eyebrow={d.pricing.sec.eyebrow} h2={d.pricing.sec.h2} id="pricing" open>
    <p class="sx-lead" set:html={d.pricing.lead} />
    <div class="mg-plans">
      <article class="card rp-plan mw-tier"><p class="rp-k">{t0.label}</p><h3 id={t0.id} set:html={t0.h} /><p class="rp-for" set:html={t0.forLine} /><p class="rp-price">{money(P.hostMove)} <small>/ one-time fee</small></p><ul class="mw-list">{t0.list.map((li) => <li><Fragment set:html={tick} /><span set:html={li} /></li>)}</ul><a class="btn ghost" href={t0.link.href}>{t0.link.label}</a></article>
      <article class="card rp-plan mw-tier pop">{t1.tag && <span class="pp-tag">{t1.tag}</span>}<p class="rp-k">{t1.label}</p><h3 id={t1.id} set:html={t1.h} /><p class="rp-for" set:html={t1.forLine} /><p class="rp-price">{money(P.full)} <small>/ one-time fee</small></p><ul class="mw-list">{t1.list.map((li) => <li><Fragment set:html={tick} /><span set:html={li} /></li>)}</ul><a class="btn primary" href={t1.link.href}>{t1.link.label}</a></article>
      <article class="card rp-plan mw-tier mg-wide"><div><p class="rp-k">{t2.label}</p><h3 id={t2.id} set:html={t2.h} /><p class="rp-for" set:html={t2.forLine} /><p class="rp-price">From {money(P.platformFrom)}</p><a class="btn ghost" href={t2.link.href}>{t2.link.label}</a></div>
        <ul class="hk-chips mg-scope">{['Number of pages', 'Domain change and redirect volume', 'Database size', 'File storage', 'eCommerce catalog size', 'Custom CMS or integrations'].map((c) => <li>{c}</li>)}</ul></article>
    </div>
    {/* Owner, 2026-11-06: "with no downtime" and "No downtime" are approved (CLAIMS-AND-DESIGN.md A4b) and show in the Host-to-Host card. */}
    <Fragment set:html={rm('Read more', `<p>${t2.priceText}</p>`)} />
    <p class="rp-note"><Fragment set:html={tick} /><span><a href="/free-website-maintenance-audit/">Get a free website check</a></span></p>
    <div class="rp-strip mw-prose" set:html={d.pricing.strip} />
  </SectionAccordion>

  <SectionAccordion eyebrow={d.included.sec.eyebrow} h2={d.included.sec.h2} id={d.included.sec.id} alt>
    <p class="sx-lead" set:html={d.included.lead} />
    <ul class="mg-inc">{d.included.items.filter((x) => !x.held).slice(0, 4).map((x) => <li class="card"><h3 id={x.id} set:html={x.h} /><p set:html={x.p} /></li>)}</ul>
    <details class="pp-rm"><summary>Show {d.included.items.filter((x) => !x.held).length - 4} more included items<Fragment set:html={icon('down')} /></summary><ul class="mg-inc">{d.included.items.filter((x) => !x.held).slice(4).map((x) => <li class="card"><h3 id={x.id} set:html={x.h} /><p set:html={x.p} /></li>)}</ul></details>
    <Fragment set:html={OWNER('"30-Day Post Support Window" and "Free fix within 30 days" (held by the brief, rule 6)') + rm('Read more', d.included.items.filter((x) => x.held).map((x) => `<h3 id="${x.id}">${x.h}</h3><p>${x.p}</p>`).join(''))} />
    <div class="rp-strip mw-prose"><div><p class="rp-k">{d.included.checklist.label}</p><Fragment set:html={d.included.checklist.h3 + d.included.checklist.p} /></div><Fragment set:html={d.included.checklist.link} /></div>
  </SectionAccordion>

  <SectionAccordion eyebrow={d.why.sec.eyebrow} h2={d.why.sec.h2} id={d.why.sec.id}>
    <p class="sx-lead" set:html={d.why.lead} />
    <Fragment set:html={d.why.h3.replace('<h3', '<h3 class="hk-h3"')} />
    <p class="pp-swipe" aria-hidden="true">Swipe sideways to compare</p>
    <div class="pp-tscroll rp-tscroll" tabindex="0" role="region" aria-label="DIY plugins and professional migration, scrolls sideways"><table class="pp-t rp-t">
      <thead><tr>{d.why.head.map((h, i) => <th scope="col" class:list={{ w: i === 2 }} set:html={h} />)}</tr></thead>
      <tbody>{d.why.rows.map(([f, ...cs]) => <tr><th scope="row" set:html={f} />{cs.map((c, i) => <td class:list={{ w: i === 1 }} set:html={(/^Zero size limits/.test(c) ? OWNER('"Zero size limits" (held by the brief, rule 6)') : '') + c} />)}</tr>)}</tbody>
    </table></div>
    <Fragment set:html={OWNER('"Free fix within 30 days" (held by the brief, rule 6); the paragraph keeps the emergency recovery link') + rm('Read more', d.why.freeFix)} />
    <div class="mw-prose mw-after" set:html={d.why.after} />
  </SectionAccordion>

  <SectionAccordion eyebrow={d.cases.sec.eyebrow} h2={d.cases.sec.h2} id={d.cases.sec.id} alt>
    {/* Auto-scrolling strip, CSS only: the row is repeated once (hidden from screen readers), pauses on hover, focus
        and touch, and stands still for people who prefer less motion. People can also scroll it by hand. */}
    <div class="mg-marquee" tabindex="0" role="region" aria-label="Migration case studies, scrolls sideways">
      <div class="mg-track"><Fragment set:html={d.cases.items.map((c) => caseCard(c, false)).join('') + d.cases.items.map((c) => caseCard(c, true)).join('')} /></div>
    </div>
    <p class="rp-subhd">{d.cases.moreTitle}</p>
    <div class="mw-prose mg-more" set:html={d.cases.moreLinks + d.cases.works} />
  </SectionAccordion>

  <SectionAccordion eyebrow={d.faq.sec.eyebrow} h2={d.faq.sec.h2} id={d.faq.sec.id}>
    <p class="sx-lead" set:html={d.faq.lead} />
    <div class="pp-faq rp-faq hk-faq">
      <Fragment set:html={d.faq.items.slice(0, 6).map((f, i) => faqItem(f, FAQ_NOTE[i] ?? '')).join('')} />
      <details class="pp-rm pp-faq-more"><summary>Show all {d.faq.items.length} questions<Fragment set:html={icon('down')} /></summary><div class="pp-faq hk-faq" set:html={d.faq.items.slice(6).map((f) => faqItem(f)).join('')} /></details>
    </div>
  </SectionAccordion>

  {/* The page's closing section and related links, as before; the Base.astro call to action follows it. */}
  <section class="pp-sec mw-closing"><div class="wrap">
    {d.closing.sec.eyebrow && <p class="eyebrow">{d.closing.sec.eyebrow}</p>}
    <h2 id={d.closing.sec.id} set:html={d.closing.sec.h2} />
    <div class="mw-prose mw-close mg-close" set:html={d.closing.html} />
  </div></section>
  {guides.length > 0 && <SectionAccordion h2="Guides" alt><div class="pp-rel">{guides.map((p) => <a href={p!.data.path}>{p!.data.h1}</a>)}</div></SectionAccordion>}
  <section class="hk-countries"><div class="wrap"><Countries /></div></section>
  <div class="pp-stick"><a class="btn primary" href="#quote">{d.hero.links[0].label}</a></div>
</div>
