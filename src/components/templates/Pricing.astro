---
// Pricing page, CLAIMS-AND-DESIGN.md B3. Old text stays in the HTML.
import prices from '../../data/prices.json';
import features from '../../data/features.json';
import { plansHtml } from '../../lib/plans';
import { factCard, polish, hlLast } from '../../lib/polish';
import { icon } from '../../lib/icons';
import { splitBy, take } from '../../lib/html-sections';

const { entry } = Astro.props;
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
const explain = features.explain as Record<string, string>;
const rank: Record<string, number> = { Essential: 0, Growth: 1, Business: 2 };
const has = (from: string, plan: string, only?: string) => (only ? rank[plan] === rank[from] : rank[plan] >= rank[from]);
const allRows = features.groups.flatMap((g) => g.rows);
const { intro, sections } = splitBy(entry.rendered?.html ?? '', 2);
const faq = take(sections, /^Frequently Asked Questions/);
const rest = polish([intro, ...sections.map((s) => s.html)].join(''), { start: 3 });
// The billing questions come first in the page's one FAQ section.
const billing = [
  ['How does billing work?', `Pay monthly, or pay yearly and get ${prices.annualNote.en}. There is no checkout on the site: pick a plan, we talk on a short call, and then we take payment.`],
  ['Is there a contract?', 'No contract. Cancel anytime.'],
  ['What happens after the first year of free hosting?', 'Hosting is free for your first year on every plan. After that, hosting is $19/month or $190/year. You can keep hosting with us or move it. There is no contract.'],
  ['How does the free month work?', `On monthly billing, your first month is free and you start paying from the second month. It does not apply to annual billing, which already has ${prices.annualNote.en}.`],
  ['What do the webmail accounts include?', 'Every plan comes with 2 free webmail accounts, so you can send and receive business email in a browser. We go through the setup with you on your call.'],
].map(([q, a]) => `<details><summary>${q}</summary><p>${a}</p></details>`).join('');
const faqHtml = faq ? polish(faq.html.replace(/(<\/h2>)/, `$1${billing}`), { start: 2 }) : '';
---
<section class="page-hero"><div class="wrap hero-split">
  <div>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / {entry.data.h1}</nav>
    <h1 set:html={hlLast(entry.data.h1.replace(/&/g, '&amp;'))} />
    <p class="sub">Three plans. Every price is here. No contract, and you can cancel anytime.</p>
  </div>
  <div class="hero-side" set:html={factCard(`Plans from ${money(prices.plans[0].monthly)}/mo`, ['First month free', 'Free hosting for the first year', '2 free webmail accounts', 'No contract'])} />
</div></section>
<section class="sec"><div class="wrap">
  <h2 class="sr-only">Plans</h2>
  <Fragment set:html={plansHtml()} />
  <div class="callout"><div><p><strong>No contract. Cancel anytime. We take payment after a short call.</strong></p></div><div class="act"><a class="btn ghost" href="/website-migration-services/">Free migration with any annual plan</a></div></div>
  <div class="callout"><div><p><strong>Running an online store?</strong></p></div><div class="act"><a class="btn ghost" href="/ecommerce-website-maintenance-packages/">WooCommerce store plans</a><a class="btn ghost" href="/shopify-website-maintenance-packages/">Shopify store plans</a></div></div>
</div></section>

<section class="sec alt"><div class="wrap">
  <div class="head"><p class="eyebrow">Compare</p><h2>Compare every feature</h2><p class="intro">Select a feature to see what it means.</p></div>
  <table class="tbl compare-t">
    <thead><tr><th scope="col">Feature</th>{prices.plans.map((p) => <th scope="col">{p.name}<small>{money(p.monthly)}/mo</small></th>)}</tr></thead>
    <tbody>
      {features.groups.map((g) => (
        <>
          <tr class="group"><td colspan="4">{g.name}</td></tr>
          {g.rows.map(([name, from, only]) => (
            <tr><td><details><summary>{name}</summary><p>{explain[name]}</p></details></td>{prices.plans.map((p) => <td>{has(from, p.name, only) ? <span class="inc">Included</span> : <span class="dash-none">—</span>}</td>)}</tr>
          ))}
        </>
      ))}
      <tr class="group"><td colspan="4">Add-ons, on any plan</td></tr>
      {features.addons.map((a) => <tr><td>{a}</td><td colspan="3"><a href="/get-a-free-quote/">Ask for a price</a></td></tr>)}
    </tbody>
  </table>
  <div class="compare-cards">
    {prices.plans.map((p) => (
      <div class="card"><h3>{p.name} · {money(p.monthly)}/mo</h3><ul>{allRows.map(([name, from, only]) => <li><span>{name}</span>{has(from, p.name, only) ? <span class="inc">Included</span> : <span class="dash-none">—</span>}</li>)}</ul><a class="btn primary" href={`/get-a-free-quote/#${p.name.toLowerCase()}`}>Start {p.name}</a></div>
    ))}
    <div class="card"><h3>Add-ons, on any plan</h3><ul>{features.addons.map((a) => <li><span>{a}</span><a href="/get-a-free-quote/">Ask for a price</a></li>)}</ul></div>
  </div>
  <div class="btn-row row-end">{prices.plans.map((p) => <a class:list={['btn', p.popular ? 'primary' : 'ghost']} href={`/get-a-free-quote/#${p.name.toLowerCase()}`}>Start {p.name}<Fragment set:html={icon('arrow')} /></a>)}</div>
</div></section>

<Fragment set:html={faqHtml} />
<Fragment set:html={rest} />
