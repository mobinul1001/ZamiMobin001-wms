---
// Pricing page, CLAIMS-AND-DESIGN.md B3. Old text stays in the HTML under expandable sections.
import PlanCards from '../PlanCards.astro';
import prices from '../../data/prices.json';
import features from '../../data/features.json';
import { splitBy, take, dropHeading } from '../../lib/html-sections';

const { entry } = Astro.props;
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
const explain = features.explain as Record<string, string>;
const rank: Record<string, number> = { Essential: 0, Growth: 1, Business: 2 };
const has = (from: string, plan: string) => rank[plan] >= rank[from];
const allRows = features.groups.flatMap((g) => g.rows);
const { intro, sections } = splitBy(entry.rendered?.html ?? '', 2);
const faq = take(sections, /^Frequently Asked Questions/);
const lead = take(sections, /^Reliable Website Care/);
const rest = sections;
const leadParts = lead ? splitBy(dropHeading(lead.html), 3) : { intro: '', sections: [] };
---
<section class="hero" style="padding-bottom:24px"><div class="wrap" style="display:block">
  <h1 style="max-width:18em">{entry.data.h1}</h1>
  <p class="sub">Three plans. Every price is here. No contract, and you can cancel anytime.</p>
</div></section>
<section style="padding-bottom:56px"><div class="wrap">
  <h2 class="sr-only">Plans</h2>
  <input class="bill" type="radio" name="bill" id="bm" checked aria-label="Monthly billing" /><input class="bill" type="radio" name="bill" id="by" aria-label="Annual billing" />
  <div class="toggle" role="group" aria-label="Billing period"><label for="bm">Monthly</label><label for="by">Annual <span class="free-pill">{prices.annualNote.en}</span></label></div>
  <PlanCards toggle />
  <p class="promise">No contract. Cancel anytime. We take payment after a short call.</p>
</div></section>

<section class="band tint"><div class="wrap">
  <div class="head"><h2>Compare every feature</h2><p>Select a feature to see what it means.</p></div>
  <div class="compare desktop"><table>
    <thead><tr><th>Feature</th>{prices.plans.map((p) => <th>{p.name}<br /><span class="small muted">{money(p.monthly)}/mo</span></th>)}</tr></thead>
    <tbody>
      {features.groups.map((g) => (
        <>
          <tr class="group"><td colspan="4">{g.name}</td></tr>
          {g.rows.map(([name, from]) => (
            <tr><td><details><summary>{name}</summary><p>{explain[name]}</p></details></td>{prices.plans.map((p) => <td>{has(from, p.name) ? <span class="inc">Included</span> : <span class="dash">—</span>}</td>)}</tr>
          ))}
        </>
      ))}
      <tr class="group"><td colspan="4">Add-ons, on any plan</td></tr>
      {features.addons.map((a) => <tr><td>{a}</td><td colspan="3"><a href="/get-a-free-quote/">Ask for a price</a></td></tr>)}
      <tr><td></td>{prices.plans.map((p) => <td><a class:list={['btn', { ghost: !p.popular }]} href={`/get-a-free-quote/#${p.name.toLowerCase()}`} style="width:100%;padding-inline:8px">Start {p.name}</a></td>)}</tr>
    </tbody>
  </table></div>
  <div class="compare-cards">
    {prices.plans.map((p) => (
      <div class="tile"><h3>{p.name} · {money(p.monthly)}/mo</h3><ul>{allRows.map(([name, from]) => <li><span>{name}</span>{has(from, p.name) ? <span class="inc">Included</span> : <span class="dash">—</span>}</li>)}</ul><a class="btn" href={`/get-a-free-quote/#${p.name.toLowerCase()}`} style="margin-top:12px">Start {p.name}</a></div>
    ))}
    <div class="tile"><h3>Add-ons, on any plan</h3><ul>{features.addons.map((a) => <li><span>{a}</span><a href="/get-a-free-quote/">Ask for a price</a></li>)}</ul></div>
  </div>
</div></section>

<section class="band"><div class="wrap" style="max-width:820px">
  <div class="head"><h2>Billing and contract questions</h2></div>
  <div class="faq">
    <details open><summary>How does billing work?</summary><p>Pay monthly, or pay yearly and get {prices.annualNote.en}. There is no checkout on the site: pick a plan, we talk on a short call, and then we take payment.</p></details>
    <details><summary>Is there a contract?</summary><p>No contract. Cancel anytime.</p></details>
  </div>
  {faq && <div class="prose" style="margin-top:36px" set:html={faq.html} />}
</div></section>

<section class="band tint"><div class="wrap" style="max-width:820px">
  <div class="head"><h2>{lead?.title}</h2></div>
  {leadParts.intro && <div class="prose" set:html={leadParts.intro} />}
  {leadParts.sections.map((s) => <details class="more"><summary><h3 class="more-h">{s.title}</h3></summary><div class="prose" set:html={dropHeading(s.html)} /></details>)}
  {intro && <div class="prose" set:html={intro} />}
</div></section>

{rest.length > 0 && <section class="band cta-final"><div class="wrap" style="max-width:720px">{rest.map((s) => <div class="prose" set:html={s.html} />)}</div></section>}
