---
// Service, package and country pages. New first screen; the old body follows in its old order.
import { getCollection } from 'astro:content';
import hubs from '../../data/blog-hubs.json';
import prices from '../../data/prices.json';
import site from '../../data/site.json';
import { factCard, polish, hlLast } from '../../lib/polish';
import { icon } from '../../lib/icons';

const { entry } = Astro.props;
const { path, lang, h1 } = entry.data;
const local = (prices.local as Record<string, { monthly: string[]; fix: string; cleanup: string }>)[path];
const low = local?.monthly[0] ?? `$${prices.plans[0].monthly}`;
const plans = '/monthly-website-maintenance-packages/';
const quote = '/get-a-free-quote/';
const check = '/free-website-maintenance-audit/';

// Starting prices come only from the master list. Pages with an unanswered price set show none.
const FROM_LOW = ['/wordpress-website-maintenance-packages/', ...Object.keys(prices.local)];
const text = {
  en: { home: 'Home', from: `Plans from ${low}/mo · No contract`, plans: 'See plans & pricing', check: 'Get a free website check', guides: 'Guides' },
  es: { home: 'Inicio', from: `Planes desde ${low}/mes · Sin contrato`, plans: 'Ver planes y precios', check: 'Revisión gratuita del sitio', guides: 'Guías' },
  pt: { home: 'Início', from: `Planos a partir de ${low}/mês · Sem contrato`, plans: 'Ver planos e preços', check: 'Verificação gratuita do site', guides: 'Guias' },
}[(lang ?? 'en').slice(0, 2)] ?? { home: 'Home', from: '', plans: 'See plans & pricing', check: 'Get a free website check', guides: 'Guides' };

const storeSet = Object.values(prices.storePlans).find((s) => s.path === path);
const SERVICE_LINES: Record<string, string> = {
  '/wordpress-malware-removal-service/': 'Malware cleanup from $149',
  '/website-speed-optimization-services/': 'One-time speed work from $149',
  '/website-migration-services/': 'Host-to-host move $149 · Free migration with any annual plan',
  '/website-design-services/': 'Website design from $799',
  '/website-seo-services/': 'Monthly SEO from $299 · One-time SEO audit $199',
};
let priceLine = FROM_LOW.includes(path) ? text.from : '';
if (storeSet) priceLine = storeSet === prices.storePlans.shopify ? `Shopify plans from $${storeSet.plans[0].monthly}/mo · No contract` : `Store plans from $${storeSet.plans[0].monthly}/mo · No contract`;
let primary = { label: text.plans, href: local || storeSet ? '#plans' : plans };
if (path === '/website-repair-services/') {
  priceLine = `One-time fix from $${prices.oneTimeFixFrom} · No contract`;
  primary = { label: 'Get my website fixed', href: quote };
} else if (path === '/website-hacked-recovery-services/') {
  priceLine = `Hacked site cleanup $${prices.hackedSiteCleanup}`;
  primary = { label: 'Get my site cleaned', href: quote };
} else if (SERVICE_LINES[path]) {
  priceLine = SERVICE_LINES[path];
  primary = { label: 'See prices', href: '#pricing' };
} else if (!FROM_LOW.includes(path) && !path.includes('-services-for-') && !path.includes('-maintenance-packages')) {
  primary = { label: 'Get a quote', href: quote };
}

// The first full sentence of the old page becomes the sub-headline, moved rather than copied.
const paragraph = /<p>((?:(?!<\/p>|<img|<a ).){60,420})<\/p>/s;
const html = entry.rendered?.html ?? '';
const sub = paragraph.exec(html)?.[1];
let body = sub ? html.replace(paragraph, '') : html;
// The hero stays short: a longer first paragraph stays in the page, whole.
const subShort = sub && sub.length <= 200 ? sub : undefined;
if (!subShort) body = html;
// A status panel near the top of the old page moves to the right of the hero.
const beforeH2 = body.indexOf('<h2');
const panel = /<div class="status-panel">[\s\S]*?<\/div>/.exec(body);
const heroPanel = panel && (beforeH2 < 0 || panel.index < beforeH2) ? panel[0] : '';
if (heroPanel) body = body.replace(heroPanel, '').replace(/<div class="card">\s*<\/div>/, '');

if (storeSet) {
  const first = body.search(new RegExp(`<h[34][^>]*>${storeSet.plans[0].name}</h[34]>`));
  const section = body.slice(0, first).search(/<h[1-4][^>]*>(?![\s\S]*<h[1-4])/);
  if (first < 0 || section < 0) throw new Error(`${path}: store plan cards not found`);
  body = `${body.slice(0, section)}<div id="plans"></div>${body.slice(section)}`;
}
// Country pages: "#plans" marks the local plan cards, buy-now links go there, and the local one-off prices sit under the cards.
if (local) {
  const essential = body.search(/<h[34][^>]*>(?:Plano )?Essential<\/h[34]>/);
  const section = body.slice(0, essential).search(/<h[1-4][^>]*>(?![\s\S]*<h[1-4])/);
  const business = body.search(/<h[34][^>]*>(?:Plano )?Business<\/h[34]>/);
  const closing = /<\/ul>\s*<\/div>\s*<\/div>/.exec(body.slice(business));
  if (essential < 0 || section < 0 || business < 0 || !closing) throw new Error(`${path}: plan cards not found`);
  const end = business + closing.index + closing[0].length;
  const extras = lang === 'pt-BR' ? `Correção avulsa a partir de ${local.fix} · Limpeza de site invadido ${local.cleanup}` : `One-time fix from ${local.fix} · Hacked site cleanup ${local.cleanup}`;
  const storeLine = path.endsWith('-for-usa/') ? '<div class="btn-row"><a class="btn ghost" href="/ecommerce-website-maintenance-packages/">Running an online store? See Store plans from $199</a></div>' : '';
  body = `${body.slice(0, section)}<div id="plans"></div>${body.slice(section, end)}<p class="plan-extras">${extras}</p>${storeLine}${body.slice(end)}`;
  body = body.replace(/<a href="\/monthly-website-maintenance-packages\/">((?:Choose|Get|Let us|Escolha)[^<]*)<\/a>/g, '<a href="#plans">$1</a>');
}

const posts = await getCollection('blog');
const guides = hubs.filter((t) => t.hub === path).flatMap((t) => t.posts).slice(0, 6).map((s) => posts.find((p) => p.data.path === `/${s}/`)).filter(Boolean);
const isEn = (lang ?? 'en').startsWith('en');
const [factTitle, ...factItems] = priceLine.split(' · ');
const heroSide = heroPanel || (priceLine ? factCard(factTitle, factItems) : isEn ? `<div class="card fact-card"><div class="stats-row">${site.stats.slice(0, 1).concat(site.stats.slice(4)).map(([v, l]) => `<div class="stat"><b>${v}</b><span>${l}</span></div>`).join('')}</div></div>` : '');
const fallback = isEn ? { html: `<div class="card side-card"><div class="stats-row">${site.stats.slice(0, 2).map(([v, l]) => `<div class="stat"><b>${v}</b><span>${l}</span></div>`).join('')}</div><p>${site.statsLine}</p><div class="btn-row"><a class="btn ghost" href="/works/">See our work</a></div></div>` } : undefined;
const polished = polish(body, { layout: { fallback } });
---
<section class="page-hero"><div class="wrap hero-split">
  <div class="service-hero">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">{text.home}</a> / {h1}</nav>
    <h1 set:html={hlLast(h1.replace(/&/g, '&amp;'))} />
    {subShort && <p class="sub" set:html={subShort} />}
    <div class="btn-row cta-row"><a class="btn primary" href={primary.href}>{primary.label}<Fragment set:html={icon('arrow')} /></a><a class="btn ghost" href={check}>{text.check}</a></div>
  </div>
  {heroSide && <div class="hero-side" set:html={heroSide} />}
</div></section>
<Fragment set:html={polished} />
{guides.length > 0 && (
  <section class="sec"><div class="wrap">
    <div class="head"><p class="eyebrow">{text.guides}</p><h2>{text.guides}</h2></div>
    <div class="grid g3">{guides.map((p) => <a class="card guide-link" href={p!.data.path}><strong>{p!.data.h1}</strong></a>)}</div>
  </div></section>
)}
