---
// Contact, quote, audit and scanner pages. wireForms() in [...slug].astro connects the forms.
import site from '../../data/site.json';
import { icon } from '../../lib/icons';
import { polish, hlLast } from '../../lib/polish';
const { entry } = Astro.props;
const { path, h1 } = entry.data;
const formName = path === '/get-a-free-quote/' ? 'quote' : '';
// Batch 2b stage 7: the offer and one main button in the first screen, in each page's own words (owner, 2026-11-06).
const HERO: Record<string, [string, string]> = {
  '/free-website-maintenance-audit/': ['No cost. No pressure. No obligations.', 'Get my free review'],
  '/get-a-free-quote/': ['100% free & no obligation', 'Request my free quote'],
  '/contact/': ['Reply within 24 hours', 'Send a message'],
};
const hero = HERO[path];
let html = entry.rendered?.html ?? '';
const isScanner = path === '/website-malware-scanner/';
if (isScanner) {
  html = html.replace(
    /<p>Scan Website<\/p>/,
    `<form id="scan-form" class="scan-form"><label for="scan-url">Your website address</label><input id="scan-url" type="text" inputmode="url" autocomplete="url" placeholder="yourwebsite.com" required><button class="btn" type="submit">Scan Website</button></form>`,
  ).replace(/(<h3[^>]*>Quick Check Results<\/h3>)/, '$1<ul id="scan-quick"></ul>').replace(/(<h3[^>]*>Deep Malware &(?:#x26|amp); Blacklist Scans<\/h3>)/, '$1<ul id="scan-deep"></ul>');
}
// "How It Works" moves into the panel beside the form.
const DEFAULT_STEPS: Record<string, [string, string][]> = {
  '/contact/': [['Send the form', ''], ['We read your message', ''], ['We reply within 24 hours', ''], ['We agree the next step', '']],
  '/free-website-maintenance-audit/': [['Send your website address', ''], ['We review your website', ''], ['You get the review within 24 hours', ''], ['You decide what to fix', '']],
};
let steps = DEFAULT_STEPS[path] ?? [];
let stepsLabel = '';
const how = /<h2[^>]*>How It Works<\/h2>([\s\S]*?)(?=<h2|$)/.exec(html);
if (how && formName) {
  steps = [...how[1].matchAll(/<h3[^>]*>(.*?)<\/h3>\s*<p>(.*?)<\/p>/gs)].map((m) => [m[1], m[2]] as [string, string]);
  stepsLabel = 'How It Works';
  html = html.replace(how[0], '');
}
const formSide = isScanner ? undefined : `<div class="card side-panel">
  ${stepsLabel ? `<p class="eyebrow">${stepsLabel}</p>` : ''}<h2 class="side-title">What happens next</h2>
  <ol class="next-steps">${steps.map(([t, d], i) => `<li><span class="n">${i + 1}</span><div><strong>${t}</strong>${d ? `<p>${d}</p>` : ''}</div></li>`).join('')}</ol>
  <p class="side-reply">${icon('clock')}Reply within 24 hours</p>
  <ul class="side-contact">${path === '/contact/' ? '' : `<li>${icon('phone')}<a href="${site.phoneHref}">${site.phone}</a></li>`}<li>${icon('mail')}<a href="mailto:${site.email}">${site.email}</a></li></ul>
  <p class="side-find">Find us on</p>
  <ul class="side-badges">${site.badges.map(([href, src, alt, w, h]) => `<li><a href="${href}" rel="noopener"><img src="${src}" alt="${alt}" width="${w}" height="${h}" loading="lazy"></a></li>`).join('')}</ul>
</div>`;
---
<section class="page-hero center"><div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / {h1}</nav>
  <h1 set:html={hlLast(h1.replace(/&/g, '&amp;'))} />
  {hero && <div class="hero-offer"><p>{hero[0]}</p><a class="btn primary" href="#request-form">{hero[1]}<Fragment set:html={icon('arrow')} /></a></div>}
</div></section>
<Fragment set:html={polish(html, { layout: { formSide } }).replace('<section class="sec read"><div class="wrap"><div class="prose"><p><a id="content"></a></p></div></div></section>', '<span id="content"></span>').replace(/<form /, '<span id="request-form" class="form-anchor"></span><form ')} />
{formName === 'quote' && (
  <script is:inline>
    // Plan buttons link here as /get-a-free-quote/#essential. The hash picks the plan; service packages are kept in a hidden field.
    (function () {
      var hash = decodeURIComponent(location.hash.slice(1)).toLowerCase();
      if (!hash) return;
      var parts = /^(.+)-(usd|gbp|eur|cad|aud|chf|brl)$/.exec(hash);
      var chosen = parts ? parts[1] : hash;
      if (parts) document.querySelector('select[name="currency"]').value = parts[2].toUpperCase();
      var plan = document.querySelector('select[name="plan"]');
      var known = plan && Array.prototype.find.call(plan.options, function (o) { return o.value === chosen; });
      if (plan) plan.value = known ? chosen : 'other';
      document.getElementById('requested-package').value = hash;
    })();
  </script>
)}
{isScanner && (
  <script is:inline>
    // Runs in the browser only. Checks the address format and builds links to outside scanners.
    document.getElementById('scan-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var raw = document.getElementById('scan-url').value.trim();
      var https = /^https:\/\//i.test(raw);
      var given = /^http:\/\//i.test(raw);
      var domain = raw.replace(/^https?:\/\//i, '').split(/[\/?#]/)[0].toLowerCase();
      var valid = /^([a-z0-9-]+\.)+[a-z]{2,}$/.test(domain);
      var quick = document.getElementById('scan-quick');
      var deep = document.getElementById('scan-deep');
      quick.textContent = '';
      deep.textContent = '';
      var add = function (list, text, href) {
        var li = document.createElement('li');
        if (href) {
          var a = document.createElement('a');
          a.href = href; a.textContent = text; a.target = '_blank'; a.rel = 'noopener nofollow';
          li.appendChild(a);
        } else li.textContent = text;
        list.appendChild(li);
      };
      add(quick, valid ? 'Domain format looks valid: ' + domain : 'That does not look like a valid domain.');
      if (!valid) return;
      add(quick, https ? 'Address uses HTTPS.' : given ? 'Address uses HTTP, not HTTPS.' : 'No protocol entered, so HTTPS was not checked.');
      add(deep, 'Google Safe Browsing', 'https://transparencyreport.google.com/safe-browsing/search?url=' + encodeURIComponent(domain));
      add(deep, 'Sucuri SiteCheck', 'https://sitecheck.sucuri.net/results/' + encodeURIComponent(domain));
      add(deep, 'VirusTotal', 'https://www.virustotal.com/gui/domain/' + encodeURIComponent(domain));
    });
  </script>
)}
