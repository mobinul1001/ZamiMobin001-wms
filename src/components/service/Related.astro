---
// Related services: the page's 10 cards with their links and H3s.
import type { Repair } from '../../lib/repair';
interface Props { d: Repair }
const { d } = Astro.props;
---
<p class="sx-lead" set:html={d.related.lead} />
<div class="pp-rel rp-rel">{d.related.cards.map((c) => (
  <a href={c.href}><span><h3>{c.h}</h3><span>{c.p}</span></span></a>
))}</div>
