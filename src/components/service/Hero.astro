---
// Hero: breadcrumb, the page's eyebrow line, H1, intro, price line (prices.json), the page's two links and
// its trust lines and the old "Example" panel; the quick-quote form on the right (under the text on phones).
import prices from '../../data/prices.json';
import { icon, tick } from '../../lib/icons';
import { quickForm } from '../../lib/home';
import { hlLast } from '../../lib/polish';
import type { Repair } from '../../lib/repair';
interface Props { h1: string; d: Repair }
const { h1, d } = Astro.props;
const form = quickForm('repair', 'Get a free website check', 'Tell us about your site. We reply within 24 hours with a free check and your exact price.', 'repair');
---
<section class="rp-hero"><div class="wrap">
  <div class="rp-hero-text">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / {h1}</nav>
    <p class="eyebrow"><Fragment set:html={icon('wrench')} /><span set:html={d.hero.eyebrow} /></p>
    <h1 set:html={hlLast(h1.replace(/&/g, '&amp;'))} />
    <p class="rp-sub" set:html={d.hero.lead} />
    <p class="rp-priceline"><b>One-time fix from ${prices.oneTimeFixFrom}</b><span>No contract</span></p>
    <div class="cta-row">{d.hero.links.map((l, i) => <a class:list={['btn', i === 0 ? 'primary' : 'ghost']} href={l.href}>{l.label}{i === 0 && <Fragment set:html={icon('arrow')} />}</a>)}</div>
    <ul class="rp-ticks">{d.hero.ticks.map((t) => <li><Fragment set:html={tick} /><span set:html={t} /></li>)}</ul>
    <div class="rp-panel" set:html={d.hero.panel} />
  </div>
  <div class="rp-hero-side" id="quote">
    <Fragment set:html={form} />
  </div>
</div></section>
