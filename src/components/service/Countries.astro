---
// Countries we serve: the 10 country pages, each with its real flag (flag-icons, MIT, public/flags/, as on the homepage).
// The Brazil page is in Portuguese.
const { title = 'Countries we serve' } = Astro.props as { title?: string };
const C: [string, string, string, string?][] = [['USA', 'usa', 'us'], ['UK', 'uk', 'gb'], ['Canada', 'canada', 'ca'], ['Australia', 'australia', 'au'], ['Ireland', 'ireland', 'ie'], ['France', 'france', 'fr'], ['Netherlands', 'netherlands', 'nl'], ['Spain', 'spain', 'es'], ['Switzerland', 'switzerland', 'ch'], ['Brazil', 'brazil', 'br', 'pt-BR']];
---
<p class="rp-subhd">{title}</p>
<div class="rp-countries">{C.map(([n, s, code, lang]) => (
  <a href={`/website-maintenance-services-for-${s}/`} hreflang={lang}><img class="fl" src={`/flags/${code}.svg`} alt={`${n} flag`} width="20" height="15" loading="lazy" />{n}</a>
))}</div>
